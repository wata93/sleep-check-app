# ============================================================
# このファイルをコピーして「.env.local」という名前で保存し、
# 各値をご自身の情報に書き換えてください。
# 詳しい手順は README.md の「インストール方法」「予約URLの変更方法」を参照。
# ============================================================

# --- Supabase（データベース）---
# Supabaseダッシュボード > Project Settings > API で確認できます
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service Role Keyは絶対に公開しないでください（管理画面の集計処理のみで使用）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- 管理画面ログイン ---
# 管理画面(/admin)にログインするためのパスワード。必ず変更してください。
ADMIN_PASSWORD=change-this-password
# セッション署名用のランダムな文字列（32文字以上推奨、他人に推測されない値に）
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string-32chars+

# --- サイト全体設定 ---
# 本番公開後のURL（例: https://sleep-check.your-clinic.com）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLINIC_NAME=おおはら村鍼灸整骨院
NEXT_PUBLIC_CLINIC_TEL=04-2937-5422
NEXT_PUBLIC_CLINIC_ADDRESS=〇〇県〇〇市〇〇1-2-3
NEXT_PUBLIC_CLINIC_HOURS=平日9:00-20:00 / 土日9:00-18:00

# --- 予約導線URL ---
# 予約システム（Airリザーブ）のカレンダーURL
NEXT_PUBLIC_BOOKING_URL=https://airrsv.net/ohharamura-yoyaku/calendar
